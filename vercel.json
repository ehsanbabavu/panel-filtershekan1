{
  "functions": {
    "api/telegram.ts": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/telegram/channel/scheduled", "schedule": "30 16 * * *" }
  ],
  "rewrites": [
    {
      "source": "/api/telegram/channel/scheduled",
      "destination": "/api/telegram?action=channel-scheduled"
    },
    {
      "source": "/dashboard",
      "destination": "/"
    },
    {
      "source": "/users",
      "destination": "/"
    },
    {
      "source": "/plans",
      "destination": "/"
    },
    {
      "source": "/subscriptions",
      "destination": "/"
    },
    {
      "source": "/transactions",
      "destination": "/"
    },
    {
      "source": "/socks",
      "destination": "/"
    },
    {
      "source": "/chat",
      "destination": "/"
    },
    {
      "source": "/payment-gateway",
      "destination": "/"
    },
    {
      "source": "/telegram",
      "destination": "/"
    },
    {
      "source": "/telegram/chat",
      "destination": "/"
    },
    {
      "source": "/telegram/channel",
      "destination": "/"
    }
  ]
}
